# --- Entrypoint Router ---
case "$1" in
  run)
    cmd_run "$2"
    ;;
  pull)
    cmd_pull "$2"
    ;;
  swarm)
    cmd_swarm "$2"
    ;;
  list|ls)
    cmd_list
    ;;
  catalog)
    cmd_big_catalog
    ;;
  menu|"")
    cmd_loop_menu
    ;;
  *)
    echo -e "${C_BOLD}Usage:${C_RESET} ./colibri [menu|run <model>|swarm <family>|pull <model>|list|catalog]"
    ;;
esac
